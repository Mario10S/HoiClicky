<Window x:Class="HoiClicky.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HoiClicky" Width="880" Height="720" MinWidth="740" MinHeight="620" Background="#101218" Foreground="#F2F3F7" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="hoi / clicky" FontSize="28" FontWeight="Bold"/><TextBlock Text="A little help, right here." Foreground="#9098AC" Margin="0,6,0,30"/>
<TextBlock Text="YOUR CONNECTION" Foreground="#9CA5BD" FontSize="11"/><TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" Margin="0,10,0,14"/>
<Button x:Name="ConnectButton" Content="Continue with ChatGPT" Click="Connect_Click"/><Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" Margin="0,8,0,24"/>
<TextBlock Text="MODEL" Foreground="#9CA5BD" FontSize="11"/><ComboBox x:Name="ModelPicker" DisplayMemberPath="Name" SelectedValuePath="Slug" SelectionChanged="Model_Changed" Margin="0,10,0,8"/><Button Content="Refresh models" Click="RefreshModels_Click"/>
<TextBlock Text="PRIVACY &amp; VOICE" Foreground="#9CA5BD" FontSize="11" Margin="0,28,0,12"/>
<CheckBox x:Name="ScreenPermission" Content="Include my screen" Checked="Permission_Changed" Unchecked="Permission_Changed"/><CheckBox x:Name="MicrophonePermission" Content="Enable microphone" Checked="Permission_Changed" Unchecked="Permission_Changed"/><CheckBox x:Name="AutoSpeak" Content="Read answers aloud" Checked="Permission_Changed" Unchecked="Permission_Changed"/>
<TextBlock Text="Audio stays on this PC. Screen images go to OpenAI only when you send. Nothing is recorded in the background." TextWrapping="Wrap" FontSize="12" Foreground="#9098AC" Margin="0,16,0,0"/>
</StackPanel>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="What are we working on?" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ask about your screen. Speak or type, then send." Foreground="#9098AC" Margin="0,7,0,20"/></StackPanel>
<Border Grid.Row="1" Background="#191D27" CornerRadius="18" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="StateLabel" Text="READY" Foreground="#9BBAFF" FontSize="11" Margin="0,0,0,12"/><TextBox x:Name="AnswerText" Grid.Row="1" Text="Hey. Bring me a question and we'll figure it out." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#E4E8F2" FontSize="15"/></Grid></Border>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBox x:Name="QuestionBox" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Your question or editable voice transcript"/>
<TextBlock x:Name="VoiceHint" Text="Ctrl + Alt + Space opens chat. Ctrl + Alt + V starts / stops voice." Foreground="#9098AC" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,8"/>
<WrapPanel><Button x:Name="VoiceButton" Content="●  Speak" Click="Voice_Click"/><Button Content="Stop voice" Click="StopSpeech_Click" Margin="8,0,0,0"/><Button x:Name="AskButton" Content="Send question  →" Click="Ask_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel>
</Grid></Grid></Window>
