<Window x:Class="HoiClicky.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ask HoiClicky" Height="220" Width="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True" Background="#F7F5FA">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="What should I look at?" FontSize="18" FontWeight="SemiBold" />
    <TextBox x:Name="QuestionBox" Grid.Row="1" Margin="0,12,0,12" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="72" />
    <DockPanel Grid.Row="2">
      <TextBlock Text="A screenshot is captured when you press Send." VerticalAlignment="Center" FontSize="12" Foreground="#625E68" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="12,7" Margin="8,0,6,0" IsCancel="True" />
        <Button Content="Send" Padding="16,7" IsDefault="True" Click="Send_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
