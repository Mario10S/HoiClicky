<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HoiClicky</AssemblyName>
    <RootNamespace>HoiClicky</RootNamespace>
  </PropertyGroup>
  <ItemGroup><None Include="SpeechHost.exe" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="BuildSpeechHost" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:exe /out:SpeechHost.exe /r:&quot;$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\System.Speech\v4.0_4.0.0.0__31bf3856ad364e35\System.Speech.dll&quot; SpeechHost.source" />
  </Target>
</Project>
