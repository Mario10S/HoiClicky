<Window x:Class="HoiClicky.ResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoiClicky" Height="330" Width="420" MinHeight="220" MinWidth="320" MaxHeight="650" MaxWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="True" Background="#F7F5FA">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="HoiClicky" FontSize="17" FontWeight="SemiBold" />
    <TextBox x:Name="AnswerText" Grid.Row="1" Margin="0,12,0,12" IsReadOnly="True" BorderThickness="0" Background="White" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Read aloud" Padding="12,7" Margin="0,0,8,0" Click="Speak_Click" />
      <Button Content="Stop voice" Padding="12,7" Click="Stop_Click" />
    </StackPanel>
  </Grid>
</Window>
